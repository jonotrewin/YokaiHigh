  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Long ago, during the Great Crocodillo Wars, the people of Italy made a
    desperate pact. To end the chaos, they imprisoned the mightiest of all Italian
    Brainrot Beasts \u2014 Tung Tung Sahur \u2014 deep beneath the Vatican itself.
    There, you have rotted for countless years, day after day, night after night,
    as the world above moved on without you.\n\nBut tonight, something stirs.\n\nYou
    awaken to the cries of a nation in agony.\nPope Francis is dead.\n\nAt dawn,
    a figure approaches your cell \u2014 an Orthodox priest, cloaked in urgency.
    He tells you the terrible truth: Francis did not die naturally. He was betrayed
    \u2014 assassinated by a conservative faction within the Vatican. In their madness,
    they have resurrected Pope Benedict XVI, dragging Christendom back into a dark
    age.\n\nTo cover their treachery, they have unleashed unspeakable horrors upon
    the land: the Italian Brainrot Animals \u2014 your kin, corrupted and enraged.\n\nNow,
    only you, Tung Tung Tung Tung Tung Tung Tung Tung Tung Sahur, possess the strength
    to rally the beasts, bring them to your side, and challenge the False Pope himself.\n\nItaly
    cries out for salvation. Christendom teeters on the brink.\nYour time has come.\nRise."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 82d45ac2fc05432408526c9bbb1b7471, type: 2}
